# --- LINE Developers > Messaging API channel ---
LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=

# --- LIFF app（必須建在「LINE Login」channel 底下，不能建在 Messaging API channel）---
# LIFF_ID 例：2000000000-abcdefgh
LIFF_ID=
# LIFF_CHANNEL_ID = 那個 LINE Login channel 的 Channel ID（驗證使用者身分用）
# 注意：不是 Messaging API channel 的 ID
LIFF_CHANNEL_ID=

# --- 資料庫 ---
# 有填 TURSO_DATABASE_URL 就走 Turso 雲端（線上部署用）
# 留空則走本機 SQLite 檔（開發用），路徑由 DB_PATH 決定
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# --- 其他 ---
PORT=3000
DB_PATH=./data/split.db

# 本機開發用：填了就跳過 LINE 身分驗證，直接用輸入的名字當使用者
# 上線前務必註解掉！
# DEV_USER=測試員
